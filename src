];

function App() {
  const [view, setView] = useState<View>("Dashboard");
  const [collapsed, setCollapsed] = useState(false);
  const [mobileNav, setMobileNav] = useState(false);
  const [search, setSearch] = useState("");
  const [notice, setNotice] = useState<string | null>("HITMS foundation is ready. Database connection can be enabled next.");

  const filteredStudents = useMemo(
    () => students.filter(row => row.join(" ").toLowerCase().includes(search.toLowerCase())),
    [search]
  );

  function openView(v: View) {
    setView(v);
    setMobileNav(false);
  }

  return (
    <div className="app-shell">
      {notice && (
        <div className="system-banner">
          <div><Sparkles size={16} /> <span>{notice}</span></div>
          <button onClick={() => setNotice(null)} aria-label="Dismiss"><X size={16} /></button>
        </div>
      )}

      <aside className={`sidebar ${collapsed ? "collapsed" : ""} ${mobileNav ? "mobile-open" : ""}`}>
        <div className="brand">
          <div className="brand-mark"><GraduationCap size={22} /></div>
          {!collapsed && <div><strong>HITMS</strong><span>University Platform</span></div>}
        </div>

        <div className="sidebar-section-label">{!collapsed && "WORKSPACE"}</div>
        <nav>
          {nav.map(({ label, icon: Icon }) => (
            <button
              key={label}
              className={`nav-item ${view === label ? "active" : ""}`}
              onClick={() => openView(label)}
              title={collapsed ? label : undefined}
            >
              <Icon size={18} />
              {!collapsed && <span>{label}</span>}
            </button>
          ))}
        </nav>

        <div className="sidebar-footer">
          <div className="security-mini">
            <ShieldCheck size={18} />
            {!collapsed && <div><strong>Security</strong><span>Role-based access</span></div>}
          </div>
          {!collapsed && <div className="version">HITMS v0.1 Foundation</div>}
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div className="top-left">
            <button className="icon-btn mobile-menu" onClick={() => setMobileNav(!mobileNav)}><Menu size={20} /></button>
            <button className="icon-btn desktop-collapse" onClick={() => setCollapsed(!collapsed)}>
              {collapsed ? <PanelLeftOpen size={20} /> : <PanelLeftClose size={20} />}
            </button>
            <div className="breadcrumb"><span>HITMS</span><ChevronDown size={14} /><strong>{view}</strong></div>
          </div>
          <div className="top-actions">
            <div className="global-search">
              <Search size={17} />
              <input value={search} onChange={e => setSearch(e.target.value)} placeholder="Search students, courses..." />
              <kbd>⌘ K</kbd>
            </div>
            <button className="icon-btn notification"><Bell size={19} /><i /></button>
            <div className="profile">
              <div className="avatar">SA</div>
              <div className="profile-copy"><strong>Engineer Syed Ansab Maqsood</strong><span>Administrator</span></div>
              <ChevronDown size={15} />
            </div>
          </div>
        </header>

        <div className="content">
          {view === "Dashboard" ? (
            <Dashboard openView={openView} />
          ) : view === "Students" ? (
            <Students rows={filteredStudents} />
          ) : (
            <ModuleView title={view} />
          )}
        </div>
      </main>
    </div>
  );
}

